{
  "name": "monkguard",
  "version": "0.1.2",
  "description": "MonkGuard: calm focus for your Mac. Stops reels, shorts and games during focus hours, limits long video sessions, and is controlled from your phone on the home wifi. No cloud, no accounts, no dependencies.",
  "type": "module",
  "bin": {
    "monk": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js run",
    "prepublishOnly": "npm run clean && npm test",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "monkguard",
    "focus",
    "parental-controls",
    "macos",
    "screen-time",
    "youtube-shorts",
    "reels",
    "kids",
    "family",
    "launchd",
    "no-dependencies"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  },
  "author": "Sandeep Sahoo (https://github.com/sandipsahoo2k2)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandipsahoo2k2/monkguard.git"
  },
  "homepage": "https://github.com/sandipsahoo2k2/monkguard#readme"
}
